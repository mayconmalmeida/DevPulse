# Dependencies
node_modules/

# Runtime data generated by DevPulse itself (local history,
# activity log, alerts log, alerts config) - never distribute
# a developer's personal usage data. The directory itself is
# kept via data/.gitkeep so a fresh clone still has the path
# the app expects (it also creates it lazily on first run).
data/*.jsonl
data/alerts-config.json

# Logs, temp, cache, debug output
*.log
logs/
tmp/
temp/
*.tmp
.cache/

# Credentials / environment - DevPulse reads provider
# credentials directly from each tool's own local files
# (~/.codex, ~/.claude, etc.) and never stores its own, but
# these are ignored defensively in case any local debugging
# file is ever created here.
.env
.env.*
*.pem
*.key

# Editor / OS artifacts
.vscode/
.idea/
Thumbs.db
.DS_Store

# Claude Code local session state (not part of the DevPulse
# app runtime)
.claude/

# Local development / design artifacts
test-codex.js
public/Painel de Marca DevPulse em Neon.png
